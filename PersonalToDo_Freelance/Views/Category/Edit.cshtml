@model PersonalToDo_Freelance.Application.ViewModels.CategoryEditViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 hover-dark">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
        </div>

        <div class="tp-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="stat-icon stat-icon-primary rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Edit Category</h3>
                    <p class="text-muted small mb-0">Update category details and status</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold text-muted">Category Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control form-control-lg fs-6" placeholder="Category name" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold text-muted">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Category description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsDeleted" class="form-check-input" id="isDeletedSwitch" role="switch" />
                        <label asp-for="IsDeleted" class="form-check-label small fw-semibold text-muted" for="isDeletedSwitch">
                            Deactivate / Hide this category
                        </label>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-medium text-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm d-inline-flex align-items-center">
                        <i class="bi bi-check2 me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

