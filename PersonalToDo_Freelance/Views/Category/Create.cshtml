@model PersonalToDo_Freelance.Application.ViewModels.CategoryCreateViewModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
        </div>

        <div class="tp-card p-3 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="stat-icon stat-icon-primary rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">New Category</h3>
                    <p class="text-muted small mb-0">Create a label to organize and group tasks</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold text-muted">Category Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control form-control-lg fs-6" placeholder="e.g., Work, Personal, Fitness, Side Project" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold text-muted">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description or purpose of this category..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm d-inline-flex align-items-center">
                        <i class="bi bi-check-lg me-1"></i> Save Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


