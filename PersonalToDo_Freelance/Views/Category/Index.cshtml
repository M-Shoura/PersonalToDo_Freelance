@model IReadOnlyList<PersonalToDo_Freelance.Application.ViewModels.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}
<h2>Categories</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<div class="table-responsive">
    <table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.Description</td>
        <td>
            <a class="btn btn-sm btn-secondary task-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger task-action" onclick="return confirm('Are you sure?');">Delete</button>
            </form>
        </td>
    </tr>
}
    </tbody>
    </table>
</div>
