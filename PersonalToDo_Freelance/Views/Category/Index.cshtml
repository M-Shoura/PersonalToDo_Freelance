@model IReadOnlyList<PersonalToDo_Freelance.Application.ViewModels.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Categories</h2>
        <p class="text-muted mb-0 small">
            <i class="bi bi-tags-fill me-1 text-primary"></i> Organize your tasks into customized categories
        </p>
    </div>
    <div>
        <a class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-medium shadow-sm d-inline-flex align-items-center" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> New Category
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-tags"></i>
        </div>
        <h4 class="fw-bold">No categories yet</h4>
        <p class="text-muted small mb-3">Create categories like Work, Personal, Fitness, or Projects to group and prioritize your tasks.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create First Category
        </a>
    </div>
}
else
{
    <div class="tp-table-card">
        <div class="table-responsive">
            <table class="table tp-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 250px;">Category Name</th>
                        <th>Description</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="stat-icon stat-icon-primary rounded-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <i class="bi bi-tag-fill"></i>
                                </div>
                                <span class="fw-bold">@item.Name</span>
                            </div>
                        </td>
                        <td class="text-muted small">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <a class="task-action-btn text-primary" asp-action="Edit" asp-route-id="@item.Id" title="Edit Category">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete this category?">
                                    <button type="submit" class="task-action-btn text-danger" title="Delete Category">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}


