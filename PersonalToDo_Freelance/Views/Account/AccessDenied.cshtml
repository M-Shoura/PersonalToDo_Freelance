@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 col-lg-5 text-center">
        <div class="tp-card p-5">
            <div class="stat-icon stat-icon-danger mx-auto rounded-circle mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
            <p class="text-muted small mb-4">You do not have the required permissions to access this page or resource.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm">
                <i class="bi bi-house-door me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>

