@model PersonalToDo_Freelance.Application.ViewModels.TaskDetailsViewModel
@{
    ViewData["Title"] = "Task Details - " + Model.Title;
    var isCompleted = Model.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed;
    var priorityClass = Model.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Critical ? "badge-priority-critical" :
                        Model.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.High ? "badge-priority-high" :
                        Model.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Medium ? "badge-priority-medium" : "badge-priority-low";
    var statusClass = Model.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed ? "badge-status-completed" :
                      Model.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.InProgress ? "badge-status-inprogress" :
                      Model.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Cancelled ? "badge-status-cancelled" : "badge-status-notstarted";
}

<!-- Breadcrumb / Back Link -->
<div class="mb-3">
    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

<!-- Task Header Banner -->
<div class="tp-card p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge-status @statusClass fs-6 py-1 px-3">@Model.Status</span>
                <span class="badge-priority @priorityClass fs-6 py-1 px-3">@Model.Priority</span>
                @if (!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <span class="category-pill fs-6 py-1 px-3">
                        <i class="bi bi-tag-fill opacity-50"></i> @Model.CategoryName
                    </span>
                }
                @if (Model.IsRecurring)
                {
                    <span class="badge bg-primary-subtle text-primary rounded-pill py-1 px-3 fs-6">
                        <i class="bi bi-repeat me-1"></i> Recurring Task
                    </span>
                }
            </div>
            <h2 class="fw-bold mb-1 @(isCompleted ? "text-decoration-line-through text-muted" : "")">@Model.Title</h2>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-medium shadow-sm d-inline-flex align-items-center">
                <i class="bi bi-pencil-fill me-1"></i> Edit
            </a>
            <a asp-action="Reschedule" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-medium d-inline-flex align-items-center">
                <i class="bi bi-calendar-event me-1"></i> Reschedule
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete this task? This action cannot be undone.">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-medium d-inline-flex align-items-center">
                    <i class="bi bi-trash-fill me-1"></i> Delete
                </button>
            </form>
        </div>
    </div>
</div>

@if (Model.IsOverdue)
{
    <div class="alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center gap-3 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill fs-3 text-danger"></i>
        <div>
            <div class="fw-bold">This task is past its due date!</div>
            <div class="small">The due date was @Model.DueDate?.ToString("MMMM dd, yyyy"). Reschedule or mark it completed to stay on track.</div>
        </div>
    </div>
}

<div class="row g-3 g-md-4 mb-4">
    <!-- Main Content: Description -->
    <div class="col-12 col-lg-8">
        <div class="tp-card p-3 p-md-4 h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-text-left text-primary"></i> Description & Notes
            </h5>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="p-3 rounded-3" style="background: var(--tp-surface-input); color: var(--tp-text-primary); border: 1px solid var(--tp-border-color); white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>
            }
            else
            {
                <div class="text-muted fst-italic py-3">No description provided for this task.</div>
            }
        </div>
    </div>

    <!-- Sidebar: Schedule & Metadata -->
    <div class="col-12 col-lg-4">
        <div class="tp-card p-3 p-md-4 h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i> Schedule Details
            </h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between pb-2 border-bottom">
                    <span class="text-muted small">Start Date</span>
                    <span class="fw-semibold small">@(Model.StartDate?.ToString("MMM dd, yyyy") ?? "Not set")</span>
                </div>
                <div class="d-flex justify-content-between pb-2 border-bottom">
                    <span class="text-muted small">Due Date</span>
                    <span class="fw-semibold small @(Model.IsOverdue ? "text-danger" : "")">@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "Not set")</span>
                </div>
                <div class="d-flex justify-content-between pb-2 border-bottom">
                    <span class="text-muted small">Created</span>
                    <span class="fw-semibold small">@Model.CreatedAt.ToString("g")</span>
                </div>
                <div class="d-flex justify-content-between pb-2 border-bottom">
                    <span class="text-muted small">Last Updated</span>
                    <span class="fw-semibold small">@(Model.UpdatedAt?.ToString("g") ?? "Never")</span>
                </div>
                @if (Model.CompletedAt.HasValue)
                {
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted small">Completed Date</span>
                        <span class="fw-semibold small text-success">@Model.CompletedAt.Value.ToString("g")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Task Attachments Section -->
<div class="tp-card p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-paperclip text-primary"></i> Task Attachments
                <span class="badge bg-primary-subtle text-primary rounded-pill small fw-normal">@Model.Attachments.Count</span>
            </h5>
            <small class="text-muted">Upload and manage related documents, images, and files</small>
        </div>
        <div>
            <form asp-action="UploadAttachment" asp-route-taskId="@Model.Id" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
                <input type="file" name="file" class="form-control form-control-sm" style="max-width: 250px;" required />
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 fw-medium d-inline-flex align-items-center">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload
                </button>
            </form>
        </div>
    </div>

    @if (Model.Attachments.Count == 0)
    {
        <div class="text-center py-4">
            <i class="bi bi-file-earmark-arrow-up text-muted fs-2 mb-1 d-block"></i>
            <p class="text-muted small mb-0">No files attached to this task yet. Use the upload button above to attach files.</p>
        </div>
    }
    else
    {
        <div class="row g-2 g-md-3">
            @foreach (var att in Model.Attachments)
            {
                var ext = System.IO.Path.GetExtension(att.FileName).ToLowerInvariant();
                var iconClass = ext switch
                {
                    ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg" => "bi-file-earmark-image text-info",
                    ".pdf" => "bi-file-earmark-pdf text-danger",
                    ".doc" or ".docx" => "bi-file-earmark-word text-primary",
                    ".xls" or ".xlsx" or ".csv" => "bi-file-earmark-excel text-success",
                    ".zip" or ".rar" or ".7z" => "bi-file-earmark-zip text-warning",
                    _ => "bi-file-earmark-text text-secondary"
                };

                var sizeDisplay = att.SizeBytes < 1024 * 1024 
                    ? $"{(att.SizeBytes / 1024.0):F1} KB" 
                    : $"{(att.SizeBytes / (1024.0 * 1024.0)):F2} MB";

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="p-3 rounded-3 d-flex align-items-center justify-content-between gap-2" style="background: var(--tp-surface-elevated); border: 1px solid var(--tp-border-color);">
                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                            <i class="bi @iconClass fs-4 flex-shrink-0"></i>
                            <div class="overflow-hidden">
                                <a href="@att.FilePath" target="_blank" class="text-decoration-none fw-semibold small text-truncate d-block" title="@att.FileName">
                                    @att.FileName
                                </a>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">@sizeDisplay &bull; @att.UploadedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <a href="@att.FilePath" download="@att.FileName" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;" title="Download file">
                                <i class="bi bi-download small"></i>
                            </a>
                            <form asp-action="DeleteAttachment" method="post" class="d-inline">
                                <input type="hidden" name="attachmentId" value="@att.Id" />
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm p-1 rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;" title="Delete file" data-confirm="Are you sure you want to delete this attachment?">
                                    <i class="bi bi-trash small"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (Model.IsRecurring)
{
    <div class="tp-card p-3 p-md-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3-range text-primary"></i> Generated Occurrences
                </h4>
                <small class="text-muted">Manage scheduled occurrences and recurring instances</small>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <form asp-action="GenerateOccurrences" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 align-items-center">
                    <input id="through" name="through" type="date" class="form-control form-control-sm" value="@DateTime.UtcNow.Date.AddDays(60).ToString("yyyy-MM-dd")" title="Generate occurrences up to date" />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill text-nowrap">
                        <i class="bi bi-arrow-repeat me-1"></i> Generate
                    </button>
                </form>
                <form asp-action="StopRecurrence" asp-route-id="@Model.Id" method="post" data-confirm="Are you sure you want to stop all future recurrence for this task?">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill text-nowrap">
                        <i class="bi bi-stop-circle me-1"></i> Stop Repeat
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Occurrences.Count == 0)
        {
            <div class="empty-state py-4">
                <div class="empty-state-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-bold">No occurrences generated yet</h5>
                <p class="text-muted small mb-0">Use the generate tool above to preview and create future occurrences.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table tp-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Original Recurrence</th>
                            <th>Status</th>
                            <th>Completed At</th>
                            <th>Reschedule</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var occurrence in Model.Occurrences)
                        {
                            var occStatusClass = occurrence.Status == PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Completed ? "badge-status-completed" :
                                                 occurrence.Status == PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Skipped ? "badge-status-notstarted" :
                                                 occurrence.Status == PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Cancelled ? "badge-status-cancelled" : "badge-status-inprogress";

                            <tr>
                                <td class="fw-semibold">
                                    <i class="bi bi-calendar-day text-primary me-1"></i>
                                    @occurrence.ScheduledDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-muted small">@occurrence.OriginalScheduledDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge-status @occStatusClass">@occurrence.Status</span>
                                </td>
                                <td class="text-muted small">@(occurrence.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td style="max-width: 200px;">
                                    <form asp-action="RescheduleOccurrence" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                        <input type="hidden" name="taskId" value="@Model.Id" />
                                        <input type="date" name="scheduledDate" class="form-control form-control-sm" value="@occurrence.ScheduledDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="task-action-btn" title="Save new date"><i class="bi bi-check2"></i></button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="OccurrenceDetails" asp-route-occurrenceId="@occurrence.Id" class="task-action-btn text-secondary" title="View Occurrence Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <form asp-action="ChangeOccurrenceStatus" method="post" class="d-inline">
                                            <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                            <input type="hidden" name="taskId" value="@Model.Id" />
                                            <input type="hidden" name="status" value="@((int)PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Completed)" />
                                            <button type="submit" class="btn btn-sm btn-soft-success task-action-btn" title="Complete Occurrence"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <form asp-action="ReopenOccurrence" method="post" class="d-inline">
                                            <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                            <input type="hidden" name="taskId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-soft-primary task-action-btn" title="Reopen Occurrence"><i class="bi bi-arrow-counterclockwise"></i></button>
                                        </form>
                                        <form asp-action="SkipOccurrence" method="post" class="d-inline">
                                            <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                            <input type="hidden" name="taskId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-soft-warning task-action-btn" title="Skip Occurrence"><i class="bi bi-skip-forward-fill"></i></button>
                                        </form>
                                        <form asp-action="ChangeOccurrenceStatus" method="post" class="d-inline">
                                            <input type="hidden" name="occurrenceId" value="@occurrence.Id" />
                                            <input type="hidden" name="taskId" value="@Model.Id" />
                                            <input type="hidden" name="status" value="@((int)PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Cancelled)" />
                                            <button type="submit" class="btn btn-sm btn-soft-danger task-action-btn" title="Cancel Occurrence"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}


