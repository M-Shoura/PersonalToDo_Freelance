@model PersonalToDo_Freelance.Application.ViewModels.TaskRescheduleViewModel
@{
    ViewData["Title"] = "Bulk Reschedule Overdue Tasks";
}
<h2>Bulk Reschedule Overdue Tasks</h2>
<p>This will reschedule all your overdue active tasks to the selected date. This action cannot be undone.</p>
<form asp-action="BulkReschedule" method="post">
    <div class="mb-3">
        <label asp-for="NewDueDate" class="form-label">New due date for overdue tasks</label>
        <input asp-for="NewDueDate" class="form-control" type="date" />
        <span asp-validation-for="NewDueDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger" data-confirm="Are you sure you want to reschedule all overdue tasks to this date?">Reschedule Overdue Tasks</button>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
