@model PersonalToDo_Freelance.Application.ViewModels.TaskRescheduleViewModel
@{
    ViewData["Title"] = "Bulk Reschedule Overdue Tasks";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="mb-3">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>

        <div class="tp-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="stat-icon stat-icon-danger rounded-circle mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h4 class="fw-bold mb-1">Bulk Reschedule Overdue Tasks</h4>
                <p class="text-muted small mb-0">Catch up on your workload by shifting all overdue tasks to a new target date.</p>
            </div>

            <div class="alert alert-warning rounded-3 border-0 small d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                <div>
                    <strong>Note:</strong> This action will update the due date of <strong>all active overdue tasks</strong> simultaneously.
                </div>
            </div>

            <form asp-action="BulkReschedule" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="NewDueDate" class="form-label small fw-semibold text-muted">New Due Date for Overdue Tasks</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                        <input asp-for="NewDueDate" id="bulkDateInput" class="form-control" type="date" value="@DateTime.UtcNow.Date.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="NewDueDate" class="text-danger small"></span>
                </div>

                <!-- Quick Presets -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted d-block">Quick Presets</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setBulkDate(0)">Today</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setBulkDate(1)">Tomorrow</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setBulkDate(7)">Next Week</button>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-medium shadow-sm" data-confirm="Are you sure you want to reschedule all overdue tasks to this date?">
                        Reschedule All Overdue
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setBulkDate(days) {
        const d = new Date();
        d.setDate(d.getDate() + days);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        document.getElementById('bulkDateInput').value = `${yyyy}-${mm}-${dd}`;
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


