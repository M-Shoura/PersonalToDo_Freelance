@model PersonalToDo_Freelance.Application.ViewModels.TaskOccurrenceViewModel
@{
    ViewData["Title"] = "Occurrence Details";
}

<h2>Occurrence Details</h2>

<dl class="row">
    <dt class="col-sm-3">Task</dt>
    <dd class="col-sm-9">@Model.TaskTitle</dd>

    <dt class="col-sm-3">Scheduled Date</dt>
    <dd class="col-sm-9">@Model.ScheduledDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Original Recurrence Date</dt>
    <dd class="col-sm-9">@Model.OriginalScheduledDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Completed At</dt>
    <dd class="col-sm-9">@Model.CompletedAt?.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAt</dd>

    <dt class="col-sm-3">Updated</dt>
    <dd class="col-sm-9">@Model.UpdatedAt</dd>
</dl>

<div class="mb-3">
    <form asp-action="RescheduleOccurrence" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="occurrenceId" value="@Model.Id" />
        <input type="hidden" name="taskId" value="@Model.TodoTaskId" />
        <div class="col-auto">
            <label for="scheduledDate" class="form-label">Scheduled date</label>
            <input id="scheduledDate" name="scheduledDate" type="date" class="form-control" value="@Model.ScheduledDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Reschedule</button>
        </div>
    </form>
</div>

<p>
    <form asp-action="ChangeOccurrenceStatus" method="post" style="display:inline;">
        <input type="hidden" name="occurrenceId" value="@Model.Id" />
        <input type="hidden" name="taskId" value="@Model.TodoTaskId" />
        <input type="hidden" name="status" value="@((int)PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Completed)" />
        <button type="submit" class="btn btn-success">Complete</button>
    </form>
    <form asp-action="ReopenOccurrence" method="post" style="display:inline;">
        <input type="hidden" name="occurrenceId" value="@Model.Id" />
        <input type="hidden" name="taskId" value="@Model.TodoTaskId" />
        <button type="submit" class="btn btn-outline-primary">Reopen</button>
    </form>
    <form asp-action="SkipOccurrence" method="post" style="display:inline;">
        <input type="hidden" name="occurrenceId" value="@Model.Id" />
        <input type="hidden" name="taskId" value="@Model.TodoTaskId" />
        <button type="submit" class="btn btn-outline-warning">Skip</button>
    </form>
    <form asp-action="ChangeOccurrenceStatus" method="post" style="display:inline;">
        <input type="hidden" name="occurrenceId" value="@Model.Id" />
        <input type="hidden" name="taskId" value="@Model.TodoTaskId" />
        <input type="hidden" name="status" value="@((int)PersonalToDo_Freelance.Domain.Enums.OccurrenceStatus.Cancelled)" />
        <button type="submit" class="btn btn-outline-danger">Cancel</button>
    </form>
    <a asp-action="Details" asp-route-id="@Model.TodoTaskId" class="btn btn-secondary">Back</a>
</p>
