@model PersonalToDo_Freelance.Application.ViewModels.RecurrenceRuleViewModel
@using PersonalToDo_Freelance.Domain.Enums

<div class="tp-card p-3 p-md-4 mb-4" id="recurrence-fields" style="background: var(--tp-surface-elevated); border: 1px dashed var(--tp-border-color);">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="stat-icon stat-icon-primary rounded-circle" style="width: 36px; height: 36px; font-size: 1rem;">
                <i class="bi bi-repeat"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Recurring Task Schedule</h6>
                <small class="text-muted">Automatically create repeating task occurrences</small>
            </div>
        </div>
        <div class="form-check form-switch mb-0 fs-5">
            <input asp-for="IsRecurring" class="form-check-input" id="isRecurringToggle" role="switch" />
        </div>
    </div>

    <div id="recurrenceOptions" style="@(Model.IsRecurring ? "" : "display:none;")">
        <hr class="my-3 opacity-10" />
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label asp-for="Type" class="form-label small fw-semibold text-muted">Repeat Frequency</label>
                <select asp-for="Type" class="form-select" id="recurrenceTypeSelect">
                    <option value="@((int)RecurrenceType.None)">Does not repeat</option>
                    <option value="@((int)RecurrenceType.Daily)">Daily</option>
                    <option value="@((int)RecurrenceType.Weekly)">Weekly</option>
                    <option value="@((int)RecurrenceType.Monthly)">Monthly</option>
                    <option value="@((int)RecurrenceType.Yearly)">Yearly</option>
                    <option value="@((int)RecurrenceType.Custom)">Custom</option>
                </select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>

            <div class="col-6 col-md-4">
                <label asp-for="Interval" class="form-label small fw-semibold text-muted">Every</label>
                <div class="input-group">
                    <input asp-for="Interval" class="form-control" type="number" min="1" id="recurrenceIntervalInput" />
                    <span class="input-group-text small text-muted" id="intervalUnitLabel">week(s)</span>
                </div>
                <span asp-validation-for="Interval" class="text-danger small"></span>
            </div>

            <div class="col-6 col-md-4">
                <label asp-for="EndCondition" class="form-label small fw-semibold text-muted">Ends</label>
                <select asp-for="EndCondition" class="form-select" id="recurrenceEndCondition">
                    <option value="0">Never</option>
                    <option value="1">On specific date</option>
                    <option value="2">After count</option>
                </select>
            </div>
        </div>

        <!-- Weekly Days-of-Week Checkbox Section -->
        <input asp-for="DaysOfWeek" type="hidden" id="Recurrence_DaysOfWeek" />
        <div class="mt-3 p-3 rounded-3" id="daysOfWeekSection" style="background: var(--tp-surface-card); border: 1px solid var(--tp-border-color);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label small fw-semibold text-muted mb-0">
                    <i class="bi bi-calendar-week text-primary me-1"></i> Repeat on Days
                </label>
                <span class="badge bg-primary-subtle text-primary small fw-normal">Select 1 or more days</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var day in new[] { 
                    (Flag: DaysOfWeekFlags.Saturday, Short: "Sat", Full: "Saturday"),
                    (Flag: DaysOfWeekFlags.Sunday, Short: "Sun", Full: "Sunday"),
                    (Flag: DaysOfWeekFlags.Monday, Short: "Mon", Full: "Monday"),
                    (Flag: DaysOfWeekFlags.Tuesday, Short: "Tue", Full: "Tuesday"),
                    (Flag: DaysOfWeekFlags.Wednesday, Short: "Wed", Full: "Wednesday"),
                    (Flag: DaysOfWeekFlags.Thursday, Short: "Thu", Full: "Thursday"),
                    (Flag: DaysOfWeekFlags.Friday, Short: "Fri", Full: "Friday")
                })
                {
                    var isChecked = Model?.SelectedDays?.Contains(day.Flag) == true || (Model != null && Model.DaysOfWeek.HasFlag(day.Flag));
                    <div>
                        <input class="weekday-pill-input recurrence-weekday" type="checkbox" name="Recurrence.SelectedDays" id="day_@day.Flag" value="@day.Flag" data-flag="@((int)day.Flag)" data-name="@day.Full" @(isChecked ? "checked" : "") />
                        <label class="weekday-pill-label" for="day_@day.Flag" title="@day.Full">@day.Short</label>
                    </div>
                }
            </div>
            <span asp-validation-for="DaysOfWeek" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- End Date & Max Count Rows -->
        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6" id="endDateWrapper" style="display:none;">
                <label asp-for="EndDate" class="form-label small fw-semibold text-muted">End Date</label>
                <input asp-for="EndDate" class="form-control" type="date" id="recurrenceEndDateInput" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6" id="occurrenceCountWrapper" style="display:none;">
                <label asp-for="OccurrenceCount" class="form-label small fw-semibold text-muted">Max Occurrences</label>
                <input asp-for="OccurrenceCount" class="form-control" type="number" min="1" id="recurrenceCountInput" />
                <span asp-validation-for="OccurrenceCount" class="text-danger small"></span>
            </div>
        </div>

        <!-- Live Schedule Summary -->
        <div class="mt-3 p-2 px-3 rounded-pill d-inline-flex align-items-center gap-2 small" id="scheduleSummaryBox" style="background: var(--tp-primary-light); color: var(--tp-primary); border: 1px solid var(--tp-primary-border);">
            <i class="bi bi-info-circle-fill"></i>
            <span id="scheduleSummaryText" class="fw-medium">Repeats weekly on selected days</span>
        </div>
    </div>
</div>

<script>
    (() => {
        const toggle = document.getElementById('isRecurringToggle');
        const options = document.getElementById('recurrenceOptions');
        const typeSelect = document.getElementById('recurrenceTypeSelect');
        const intervalInput = document.getElementById('recurrenceIntervalInput');
        const intervalLabel = document.getElementById('intervalUnitLabel');
        const endConditionSelect = document.getElementById('recurrenceEndCondition');
        const endDateWrapper = document.getElementById('endDateWrapper');
        const occurrenceCountWrapper = document.getElementById('occurrenceCountWrapper');
        const daysSection = document.getElementById('daysOfWeekSection');
        const hidden = document.getElementById('Recurrence_DaysOfWeek') || document.querySelector('[name$="DaysOfWeek"]');
        const boxes = document.querySelectorAll('.recurrence-weekday');
        const summaryText = document.getElementById('scheduleSummaryText');

        function updateVisibility() {
            if (toggle && options) {
                options.style.display = toggle.checked ? 'block' : 'none';
            }

            if (!toggle || !toggle.checked) return;

            const type = typeSelect ? typeSelect.value : '0';
            // Show weekdays only for Weekly (2) or Custom (5)
            if (daysSection) {
                daysSection.style.display = (type === '2' || type === '5') ? 'block' : 'none';
            }

            if (intervalLabel) {
                switch(type) {
                    case '1': intervalLabel.textContent = 'day(s)'; break;
                    case '2': intervalLabel.textContent = 'week(s)'; break;
                    case '3': intervalLabel.textContent = 'month(s)'; break;
                    case '4': intervalLabel.textContent = 'year(s)'; break;
                    default: intervalLabel.textContent = 'time(s)'; break;
                }
            }

            const endCond = endConditionSelect ? endConditionSelect.value : '0';
            if (endDateWrapper) endDateWrapper.style.display = (endCond === '1') ? 'block' : 'none';
            if (occurrenceCountWrapper) occurrenceCountWrapper.style.display = (endCond === '2') ? 'block' : 'none';

            updateSummary();
        }

        function updateDays() {
            if (!hidden) return;
            let value = 0;
            const selectedNames = [];
            boxes.forEach(box => {
                if (box.checked) {
                    const flagVal = Number(box.getAttribute('data-flag') || box.value);
                    if (!isNaN(flagVal)) value |= flagVal;
                    selectedNames.push(box.getAttribute('data-name') || box.value);
                }
            });
            hidden.value = value;
            updateSummary(selectedNames);
        }

        function updateSummary(selectedDays) {
            if (!summaryText) return;
            const type = typeSelect ? typeSelect.options[typeSelect.selectedIndex].text : 'None';
            const interval = intervalInput ? (intervalInput.value || '1') : '1';
            
            if (!selectedDays) {
                selectedDays = [];
                boxes.forEach(box => {
                    if (box.checked) selectedDays.push(box.getAttribute('data-name') || box.value);
                });
            }

            let text = `Repeats every ${interval > 1 ? interval + ' ' : ''}${type.toLowerCase()}`;
            if (type.toLowerCase() === 'weekly') {
                if (selectedDays.length > 0) {
                    text += ` on ${selectedDays.join(', ')}`;
                } else {
                    text += ` (select at least one day)`;
                }
            }

            const endCond = endConditionSelect ? endConditionSelect.value : '0';
            if (endCond === '1') {
                const endVal = document.getElementById('recurrenceEndDateInput')?.value;
                if (endVal) text += ` until ${endVal}`;
            } else if (endCond === '2') {
                const countVal = document.getElementById('recurrenceCountInput')?.value;
                if (countVal) text += ` for ${countVal} occurrence(s)`;
            }

            summaryText.textContent = text;
        }

        if (toggle) toggle.addEventListener('change', updateVisibility);
        if (typeSelect) typeSelect.addEventListener('change', updateVisibility);
        if (intervalInput) intervalInput.addEventListener('input', updateVisibility);
        if (endConditionSelect) endConditionSelect.addEventListener('change', updateVisibility);
        document.getElementById('recurrenceEndDateInput')?.addEventListener('change', updateVisibility);
        document.getElementById('recurrenceCountInput')?.addEventListener('input', updateVisibility);

        boxes.forEach(box => box.addEventListener('change', updateDays));

        // Initial setup
        updateVisibility();
        updateDays();
    })();
</script>



