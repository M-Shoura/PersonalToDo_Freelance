@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="tp-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="stat-icon stat-icon-primary rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Privacy Policy</h3>
                    <p class="text-muted small mb-0">Your privacy and personal data protection</p>
                </div>
            </div>

            <div style="line-height: 1.7;">
                <h5 class="fw-bold mb-2">1. Data Ownership</h5>
                <p class="small text-muted mb-4">Your task records, recurrence rules, and productivity statistics belong solely to you. We do not sell or distribute your private task data to third parties.</p>

                <h5 class="fw-bold mb-2">2. Account Security</h5>
                <p class="small text-muted mb-4">Your login credentials and account access are securely hashed and protected following industry-standard ASP.NET Core Identity encryption practices.</p>

                <h5 class="fw-bold mb-2">3. Cookies & Session Storage</h5>
                <p class="small text-muted mb-0">We use essential authentication and session cookies only to maintain your logged-in state and anti-forgery protection across requests.</p>
            </div>
        </div>
    </div>
</div>


