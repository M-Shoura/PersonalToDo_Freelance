@model PersonalToDo_Freelance.Application.ViewModels.StatisticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Productivity Statistics";
    var completionPercent = (int)Math.Round(Model.CompletionRate * 100);
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Productivity Analytics</h2>
        <p class="text-muted mb-0 small">
            <i class="bi bi-graph-up-arrow me-1 text-primary"></i> Track your task completion trends and performance
        </p>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav tp-nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-calendar2-day-fill"></i> Today's Tasks
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Dashboard" asp-action="All">
            <i class="bi bi-collection-fill"></i> All Tasks
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Dashboard" asp-action="Kanban">
            <i class="bi bi-kanban-fill"></i> Kanban Board
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" asp-controller="Dashboard" asp-action="Statistics">
            <i class="bi bi-bar-chart-fill"></i> Productivity Stats
        </a>
    </li>
</ul>

<!-- Filter & Date Range Card -->
<div class="filter-card mb-4">
    <form method="get" class="row g-2 align-items-end" id="statsForm">
        <div class="col-12 col-lg-5">
            <label class="form-label text-muted small fw-semibold mb-1">Quick Range Presets</label>
            <div class="btn-group w-100" role="group" aria-label="Presets">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-preset="today">Today</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-preset="week">This Week</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-preset="month">This Month</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-preset="year">This Year</button>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <label class="form-label text-muted small fw-semibold mb-1" for="startDate">Start Date</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                <input type="date" name="start" id="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <label class="form-label text-muted small fw-semibold mb-1" for="endDate">End Date</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                <input type="date" name="end" id="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-12 col-md-4 col-lg-1">
            <button type="submit" class="btn btn-primary btn-sm w-100 fw-medium">Apply</button>
        </div>
    </form>
</div>

<!-- Metrics Cards -->
<div class="row g-2 g-md-3 mb-4">
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold">Created</span>
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0">@Model.TasksCreated</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold">Completed</span>
                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-success">@Model.TasksCompleted</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold">Pending</span>
                <div class="stat-icon stat-icon-info">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-info">@Model.PendingTasks</h3>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold">Overdue</span>
                <div class="stat-icon stat-icon-danger">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 @(Model.OverdueTasks > 0 ? "text-danger" : "")">@Model.OverdueTasks</h3>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold">Completion Rate</span>
                <span class="badge bg-primary-subtle text-primary fw-bold">@completionPercent%</span>
            </div>
            <div>
                <div class="tp-progress mb-2">
                    <div class="tp-progress-bar" role="progressbar" style="width: @completionPercent%;" aria-valuenow="@completionPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span class="text-muted" style="font-size: 0.75rem;">@Model.TasksCompleted of @Model.TasksCreated tasks finished</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Grid -->
<div class="row g-3 g-md-4">
    <div class="col-12">
        <div class="tp-card p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Completed Tasks Over Time</h5>
                    <small class="text-muted">Daily breakdown of completed tasks in selected period</small>
                </div>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill"><i class="bi bi-graph-up me-1"></i> Activity</span>
            </div>
            <div style="position: relative; height: 280px;">
                <canvas id="completedChart" aria-label="Completed tasks over time" role="img"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="tp-card p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Tasks by Category</h5>
                    <small class="text-muted">Distribution across categories</small>
                </div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill"><i class="bi bi-tags me-1"></i> Categories</span>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="categoryChart" aria-label="Tasks by category" role="img"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="tp-card p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Tasks by Priority</h5>
                    <small class="text-muted">Volume by priority level</small>
                </div>
                <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill"><i class="bi bi-flag me-1"></i> Priority</span>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="priorityChart" aria-label="Tasks by priority" role="img"></canvas>
            </div>
        </div>
    </div>
</div>

@* Provide structured data to JavaScript *@
<script>
    const completedPerDayData = @Html.Raw(JsonSerializer.Serialize(Model.CompletedPerDay.Select(d => new { date = d.Date.ToString("yyyy-MM-dd"), count = d.Count })));
    const tasksByCategoryData = @Html.Raw(JsonSerializer.Serialize(Model.TasksByCategory.Select(c => new { category = c.Category, count = c.Count })));
    const tasksByPriorityData = @Html.Raw(JsonSerializer.Serialize(Model.TasksByPriority.Select(p => new { priority = p.Priority.ToString(), count = p.Count })));
</script>

@* Chart.js *@
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/statistics.js" asp-append-version="true"></script>

