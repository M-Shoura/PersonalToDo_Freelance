@model PersonalToDo_Freelance.Application.ViewModels.StatisticsViewModel
@{
    ViewData["Title"] = "Productivity Statistics";
}

<h2>Productivity Statistics</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <label class="form-label">Start</label>
        <input type="date" name="start" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label">End</label>
        <input type="date" name="end" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
</form>

<div class="row mb-3">
    <div class="col-6 col-md-2"><div class="card text-center"><div class="card-body"><div class="h6">Tasks Created</div><div class="fs-4">@Model.TasksCreated</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card text-center"><div class="card-body"><div class="h6">Tasks Completed</div><div class="fs-4">@Model.TasksCompleted</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card text-center"><div class="card-body"><div class="h6">Pending</div><div class="fs-4">@Model.PendingTasks</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card text-center"><div class="card-body"><div class="h6">Overdue</div><div class="fs-4 text-danger">@Model.OverdueTasks</div></div></div></div>
    <div class="col-12 col-md-4"><div class="card text-center"><div class="card-body"><div class="h6">Completion Rate</div><div class="fs-4">@((Model.CompletionRate*100).ToString("F0"))%</div></div></div></div>
</div>

<div class="row">
    <div class="col-12 col-md-6">
        <h4>Tasks by Category</h4>
        <table class="table table-sm">
            <thead><tr><th>Category</th><th class="text-end">Count</th></tr></thead>
            <tbody>
                @foreach(var c in Model.TasksByCategory)
                {
                    <tr><td>@c.Category</td><td class="text-end">@c.Count</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-12 col-md-6">
        <h4>Tasks by Priority</h4>
        <table class="table table-sm">
            <thead><tr><th>Priority</th><th class="text-end">Count</th></tr></thead>
            <tbody>
                @foreach(var p in Model.TasksByPriority)
                {
                    <tr><td>@p.Priority</td><td class="text-end">@p.Count</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <h4>Completed Tasks Per Day</h4>
        <table class="table table-sm">
            <thead><tr><th>Date</th><th class="text-end">Count</th></tr></thead>
            <tbody>
                @foreach(var d in Model.CompletedPerDay)
                {
                    <tr><td>@d.Date.ToString("yyyy-MM-dd")</td><td class="text-end">@d.Count</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
