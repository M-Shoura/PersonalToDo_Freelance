@model IReadOnlyList<PersonalToDo_Freelance.Application.ViewModels.TaskListItemViewModel>
@{
    ViewData["Title"] = "All Tasks";
    var q = ViewData["Query"] as PersonalToDo_Freelance.Application.ViewModels.TaskQueryParameters ?? new PersonalToDo_Freelance.Application.ViewModels.TaskQueryParameters();
    var cats = ViewData["Categories"] as IReadOnlyList<PersonalToDo_Freelance.Application.ViewModels.CategoryListItemViewModel> ?? Array.Empty<PersonalToDo_Freelance.Application.ViewModels.CategoryListItemViewModel>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">All Tasks</h2>
        <p class="text-muted mb-0 small">
            <i class="bi bi-stack me-1 text-primary"></i> View and manage your complete task list
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Task" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-medium shadow-sm d-inline-flex align-items-center">
            <i class="bi bi-plus-lg me-1"></i> Add Task
        </a>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav tp-nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-calendar2-day-fill"></i> Today's Tasks
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" asp-controller="Dashboard" asp-action="All">
            <i class="bi bi-collection-fill"></i> All Tasks
            <span class="badge bg-primary rounded-pill ms-1">@Model.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Dashboard" asp-action="Statistics">
            <i class="bi bi-bar-chart-fill"></i> Productivity Stats
        </a>
    </li>
</ul>

<!-- Search & Filter Card -->
<div class="filter-card mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="search" name="SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search all tasks..." value="@(q.SearchTerm ?? string.Empty)" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <select name="Status" class="form-select">
                <option value="">Status: All</option>
                @foreach (var s in Enum.GetValues(typeof(PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus)).Cast<PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus>())
                {
                    var sval = ((int)s).ToString();
                    if (q.Status == s)
                    {
                        <option value="@sval" selected>@s</option>
                    }
                    else
                    {
                        <option value="@sval">@s</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="CategoryId" class="form-select">
                <option value="">Category: All</option>
                @foreach (var c in cats)
                {
                    if (q.CategoryId == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="SortBy" class="form-select">
                @if (q.SortBy == PersonalToDo_Freelance.Application.ViewModels.TaskSortField.DueDate) { <option value="0" selected>Sort: Due Date</option> } else { <option value="0">Sort: Due Date</option> }
                @if (q.SortBy == PersonalToDo_Freelance.Application.ViewModels.TaskSortField.Priority) { <option value="1" selected>Sort: Priority</option> } else { <option value="1">Sort: Priority</option> }
                @if (q.SortBy == PersonalToDo_Freelance.Application.ViewModels.TaskSortField.Title) { <option value="5" selected>Sort: Title</option> } else { <option value="5">Sort: Title</option> }
            </select>
        </div>
        <div class="col-3 col-md-1">
            <select name="SortDirection" class="form-select">
                @if (q.SortDirection == PersonalToDo_Freelance.Application.ViewModels.SortDirection.Asc) { <option value="0" selected>Asc</option> } else { <option value="0">Asc</option> }
                @if (q.SortDirection == PersonalToDo_Freelance.Application.ViewModels.SortDirection.Desc) { <option value="1" selected>Desc</option> } else { <option value="1">Desc</option> }
            </select>
        </div>
        <div class="col-3 col-md-1">
            <button type="submit" class="btn btn-primary w-100 d-flex justify-content-center align-items-center">
                <i class="bi bi-filter"></i>
            </button>
        </div>
    </form>
</div>

<!-- Task List -->
@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
        </div>
        @if (!string.IsNullOrWhiteSpace(q.SearchTerm))
        {
            <h4 class="fw-bold text-dark">No tasks match your search</h4>
            <p class="text-muted small mb-3">Try adjusting your keywords or clearing the active filters.</p>
            <a asp-action="All" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Clear Filters</a>
        }
        else
        {
            <h4 class="fw-bold text-dark">No tasks found</h4>
            <p class="text-muted small mb-3">Get started by creating your first task to stay organized and productive.</p>
            <a asp-controller="Task" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create Task
            </a>
        }
    </div>
}
else
{
    <!-- Desktop Table View -->
    <div class="tp-table-card d-none d-md-block">
        <div class="table-responsive">
            <table class="table tp-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>Task Details</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="text-end" style="min-width: 190px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model)
                {
                    var isCompleted = t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed;
                    var rowClass = t.IsOverdue ? "table-danger" : (isCompleted ? "table-success" : "");
                    var priorityClass = t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Critical ? "badge-priority-critical" :
                                        t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.High ? "badge-priority-high" :
                                        t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Medium ? "badge-priority-medium" : "badge-priority-low";
                    var statusClass = t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed ? "badge-status-completed" :
                                      t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.InProgress ? "badge-status-inprogress" :
                                      t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Cancelled ? "badge-status-cancelled" : "badge-status-notstarted";

                    <tr class="@rowClass" data-task-id="@t.Id">
                        <td>
                            @if (isCompleted)
                            {
                                <button class="btn btn-sm btn-soft-primary task-action-btn" data-action="reopen" data-task-id="@t.Id" title="Reopen Task">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-soft-success task-action-btn" data-action="complete" data-task-id="@t.Id" title="Mark Complete">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <a asp-controller="Task" asp-action="Details" asp-route-id="@t.Id" class="fw-semibold text-dark text-decoration-none task-title-text @(isCompleted ? "text-decoration-line-through text-muted" : "")">
                                    @t.Title
                                </a>
                                @if (t.IsRecurring)
                                {
                                    <span class="badge bg-primary-subtle text-primary small py-1 px-2 rounded-pill" title="Recurring Task">
                                        <i class="bi bi-repeat"></i>
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(t.CategoryName))
                            {
                                <span class="category-pill">
                                    <i class="bi bi-tag-fill opacity-50"></i> @t.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge-priority @priorityClass">@t.Priority</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 small @(t.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                <i class="bi @(t.IsOverdue ? "bi-exclamation-circle-fill" : "bi-calendar3")"></i>
                                @(t.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                            </div>
                        </td>
                        <td>
                            <span class="badge-status @statusClass task-status">@t.Status</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <a asp-controller="Task" asp-action="Reschedule" asp-route-id="@t.Id" class="btn btn-sm btn-light border task-action-btn text-secondary" title="Reschedule Task">
                                    <i class="bi bi-calendar-event"></i>
                                </a>
                                <a asp-controller="Task" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-light border task-action-btn text-primary" title="Edit Task">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-controller="Task" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete this task?">
                                    <button type="submit" class="btn btn-sm btn-light border task-action-btn text-danger" title="Delete Task">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card View -->
    <div class="d-block d-md-none">
        @foreach (var t in Model)
        {
            var isCompleted = t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed;
            var priorityClass = t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Critical ? "badge-priority-critical" :
                                t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.High ? "badge-priority-high" :
                                t.Priority == PersonalToDo_Freelance.Domain.Enums.TaskPriority.Medium ? "badge-priority-medium" : "badge-priority-low";
            var statusClass = t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Completed ? "badge-status-completed" :
                              t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.InProgress ? "badge-status-inprogress" :
                              t.Status == PersonalToDo_Freelance.Domain.Enums.TodoTaskStatus.Cancelled ? "badge-status-cancelled" : "badge-status-notstarted";

            <div class="task-card-mobile @(t.IsOverdue ? "task-card-overdue" : "") @(isCompleted ? "table-success" : "")" data-task-id="@t.Id">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <a asp-controller="Task" asp-action="Details" asp-route-id="@t.Id" class="fw-semibold text-dark text-decoration-none task-title-text @(isCompleted ? "text-decoration-line-through text-muted" : "")">
                        @t.Title
                    </a>
                    <span class="badge-priority @priorityClass">@t.Priority</span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 small">
                    @if (!string.IsNullOrEmpty(t.CategoryName))
                    {
                        <span class="category-pill">
                            <i class="bi bi-tag-fill opacity-50"></i> @t.CategoryName
                        </span>
                    }
                    <span class="badge-status @statusClass task-status">@t.Status</span>
                    @if (t.IsRecurring)
                    {
                        <span class="badge bg-primary-subtle text-primary rounded-pill"><i class="bi bi-repeat"></i> Recurring</span>
                    }
                    <div class="ms-auto @(t.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                        <i class="bi bi-calendar3"></i> @(t.DueDate?.ToString("MMM dd") ?? "—")
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                        <button class="btn btn-sm btn-soft-success rounded-pill px-3 py-1 task-action" data-action="complete" data-task-id="@t.Id">
                            <i class="bi bi-check-lg me-1"></i> Done
                        </button>
                        <button class="btn btn-sm btn-soft-primary rounded-pill px-2 py-1 task-action" data-action="reopen" data-task-id="@t.Id" title="Reopen">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-controller="Task" asp-action="Reschedule" asp-route-id="@t.Id" class="btn btn-sm btn-light border task-action-btn text-secondary">
                            <i class="bi bi-calendar-event"></i>
                        </a>
                        <a asp-controller="Task" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-light border task-action-btn text-primary">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form asp-controller="Task" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete this task?">
                            <button type="submit" class="btn btn-sm btn-light border task-action-btn text-danger">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Hidden antiforgery token for AJAX *@
<form id="__antiForgeryForm">@Html.AntiForgeryToken()</form>

<script src="~/js/mytasks.js" asp-append-version="true"></script>

