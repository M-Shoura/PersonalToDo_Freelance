@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="tp-card p-4 p-md-5 text-center">
            <div class="stat-icon stat-icon-danger mx-auto rounded-circle mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Something went wrong</h3>
            <p class="text-muted small mb-4">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded-3 text-start mb-4 border">
                    <span class="text-muted small d-block mb-1">Request ID</span>
                    <code class="text-danger small">@Model.RequestId</code>
                </div>
            }

            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm">
                <i class="bi bi-house-door me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>

