@*
Reusable confirmation modal. Trigger by adding `data-confirm="Message"` to links/buttons/forms.
*@
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden text-center p-4">
      <div class="mb-3">
        <div class="stat-icon stat-icon-danger mx-auto rounded-circle" style="width: 56px; height: 56px;">
          <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>
      </div>
      <h5 class="fw-bold text-dark mb-2" id="confirmModalLabel">Confirm Action</h5>
      <p class="text-muted small mb-4" id="confirmModalBody">Are you sure you want to proceed?</p>
      <div class="d-flex gap-2 justify-content-center">
        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium text-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger rounded-pill px-4 fw-medium shadow-sm" id="confirmModalConfirm">Yes, Confirm</button>
      </div>
    </div>
  </div>
</div>

